{
  "name": "copyreactball",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "devpi": "vite --host",
    "build": "npm run build:static-pages && vite build",
    "build:static-pages": "node scripts/build-static-pages.cjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"e2e/**/*.js\" \"*.js\" \"scripts/**/*.cjs\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{js,jsx,scss,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,scss,css,html}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:prod:upload": "npm run build && npm run sync:static && npm run sync:index",
    "sync:static": "aws s3 sync dist s3://roryeagan.com-nba --delete --size-only --exclude \"index.html\" --cache-control \"public, max-age=31536000, immutable\"",
    "sync:static:headers": "aws s3 cp s3://roryeagan.com-nba s3://roryeagan.com-nba --recursive --exclude \"index.html\" --metadata-directive REPLACE --cache-control \"public, max-age=31536000, immutable\"",
    "sync:index": "aws s3 sync dist s3://roryeagan.com-nba --delete --exclude \"*\" --include \"index.html\" --cache-control \"no-cache, no-store, must-revalidate\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "14.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.15.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.2",
    "sass": "^1.71.1",
    "vite": "^5.0.0",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.6",
    "@mui/material": "^5.14.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tinycolor2": "^1.6.0"
  }
}
